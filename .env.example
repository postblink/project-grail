# ---------------------------------------------------------------------------
# Project Grail — environment variables
# Copy to .env (or .env.local) and fill in. Never commit a populated copy.
# ---------------------------------------------------------------------------

# Database (Railway, Supabase, Neon, or self-hosted Postgres all work)
DATABASE_URL="postgresql://user:password@host:5432/grail?sslmode=require"

# NextAuth.js — set both to the public origin of your deployment.
# AUTH_URL is the v5 name; NEXTAUTH_URL is read by some adapters.
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# Random 32+ char string for JWT signing. Generate with:
#   openssl rand -base64 48
NEXTAUTH_SECRET=""

# Discord OAuth — create an app at https://discord.com/developers/applications
# Set redirect URI: $NEXTAUTH_URL/api/auth/callback/discord
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Project Diablo 2 OAuth — optional, used for shared-stash import.
# Apply at https://projectdiablo2.com (contact PD2 staff for OAuth access).
# Set redirect URI: $NEXTAUTH_URL/api/auth/callback/pd2
PD2_CLIENT_ID=""
PD2_CLIENT_SECRET=""

# Resend — magic-link email auth.
# Free tier supports the volume of a small community.
# https://resend.com — verify your sending domain first.
RESEND_API_KEY=""
EMAIL_FROM="Project Grail <noreply@your-domain.example>"

# Shared secret for the Discord-batch flush cron endpoint at
# /api/cron/discord-flush. The GitHub Actions workflow at
# .github/workflows/discord-flush.yml uses this as a bearer token.
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# Sentry — optional, comment out the withSentryConfig wrapper in
# next.config.ts if you don't want error monitoring.
# SENTRY_AUTH_TOKEN=""
# SENTRY_DSN=""
