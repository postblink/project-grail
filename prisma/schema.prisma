// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ItemCategory {
  unique
  set
  runeword
  rune
  other
}

enum ImportSource {
  manual
  armory
}

enum ImportStatus {
  success
  partial
  failed
}

enum LeagueType {
  cooperative
  competitive
  hybrid
}

enum LadderMode {
  softcore_ladder
  hardcore_ladder
  softcore_nonladder
  hardcore_nonladder
}

enum MemberRole {
  member
  co_commissioner
  commissioner
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth v5) required models
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Application models
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  display_name  String?
  discord_id    String?   @unique @map("discord_id")
  is_admin      Boolean   @default(false)
  created_at    DateTime  @default(now())
  deleted_at    DateTime?

  accounts         Account[]
  sessions         Session[]
  grails           Grail[]
  leagues_created  League[]         @relation("Commissioner")
  league_members   LeagueMember[]
  armory_imports   ArmoryImport[]
  league_finds     LeagueGrailEntry[]

  @@map("users")
}

model Season {
  id         String    @id @default(cuid())
  name       String
  slug       String    @unique
  start_date DateTime
  end_date   DateTime?
  is_active  Boolean   @default(true)
  is_current Boolean   @default(false)
  created_at DateTime  @default(now())

  grails            Grail[]
  leagues           League[]
  items_introduced  Item[]

  @@map("seasons")
}

model Item {
  id                   String       @id @default(cuid())
  name                 String       @unique
  category             ItemCategory
  item_type            String?
  set_name             String?
  pd2_exclusive        Boolean      @default(false)
  season_introduced_id String?      @map("season_introduced_id")
  is_active            Boolean      @default(true)
  wiki_url             String?
  created_at           DateTime     @default(now())

  season_introduced    Season?            @relation(fields: [season_introduced_id], references: [id])
  grail_entries        GrailEntry[]
  league_grail_entries LeagueGrailEntry[]

  @@map("items")
}

model Grail {
  id         String   @id @default(cuid())
  user_id    String
  season_id  String?
  is_alltime Boolean  @default(false)
  created_at DateTime @default(now())

  user           User           @relation(fields: [user_id], references: [id])
  season         Season?        @relation(fields: [season_id], references: [id])
  entries        GrailEntry[]
  armory_imports ArmoryImport[]

  @@unique([user_id, season_id])
  @@map("grails")
}

model GrailEntry {
  id             String       @id @default(cuid())
  grail_id       String
  item_id        String
  found          Boolean      @default(false)
  found_at       DateTime?
  import_source  ImportSource @default(manual)

  grail Grail @relation(fields: [grail_id], references: [id])
  item  Item  @relation(fields: [item_id], references: [id])

  @@unique([grail_id, item_id])
  @@map("grail_entries")
}

model ArmoryImport {
  id             String       @id @default(cuid())
  grail_id       String
  user_id        String
  characters     String[]
  status         ImportStatus
  items_added    Int          @default(0)
  error_details  String?
  created_at     DateTime     @default(now())

  grail Grail @relation(fields: [grail_id], references: [id])
  user  User  @relation(fields: [user_id], references: [id])

  @@map("armory_imports")
}

model League {
  id                  String     @id @default(cuid())
  name                String
  slug                String     @unique
  commissioner_id     String
  season_id           String
  league_type         LeagueType
  ladder_mode         LadderMode
  grail_scope         Json
  is_private          Boolean    @default(false)
  invite_code         String?    @unique
  start_date          DateTime
  end_date            DateTime?
  discord_webhook_url String?
  created_at          DateTime   @default(now())

  commissioner         User               @relation("Commissioner", fields: [commissioner_id], references: [id])
  season               Season             @relation(fields: [season_id], references: [id])
  members              LeagueMember[]
  league_grail_entries LeagueGrailEntry[]

  @@map("leagues")
}

model LeagueMember {
  id        String     @id @default(cuid())
  league_id String
  user_id   String
  role      MemberRole @default(member)
  joined_at DateTime   @default(now())

  league League @relation(fields: [league_id], references: [id])
  user   User   @relation(fields: [user_id], references: [id])

  @@unique([league_id, user_id])
  @@map("league_members")
}

model LeagueGrailEntry {
  id               String   @id @default(cuid())
  league_id        String
  item_id          String
  found_by_user_id String
  found_at         DateTime @default(now())

  league       League @relation(fields: [league_id], references: [id])
  item         Item   @relation(fields: [item_id], references: [id])
  found_by     User   @relation(fields: [found_by_user_id], references: [id])

  @@unique([league_id, item_id])
  @@map("league_grail_entries")
}
